{
  "name": "icosa",
  "version": "2.1.1",
  "private": true,
  "description": "Polyhedron — desktop translator for Baldur's Gate 3 mod localization.",
  "main": "./out/main/index.js",
  "author": {
    "name": "kaironn",
    "url": "https://github.com/Kaironn2"
  },
  "homepage": "https://github.com/Gabrielish/Polyhedron#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabrielish/Polyhedron.git"
  },
  "bugs": {
    "url": "https://github.com/Gabrielish/Polyhedron/issues"
  },
  "scripts": {
    "build:dialog-index": "node scripts/build-dialog-index.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run build:dialog-index && npm run build:reference-index && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "db:studio": "drizzle-kit studio",
    "build:reference-index": "node scripts/build-reference-index.mjs && node scripts/build-dialog-reference-module.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google-cloud/local-auth": "^3.0.1",
    "@tanstack/react-virtual": "^3.13.24",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "es-object-atoms": "1.1.1",
    "fast-xml-parser": "^5.7.2",
    "fuse.js": "^7.3.0",
    "fzstd": "^0.1.1",
    "googleapis": "^176.0.0",
    "i18next": "^26.0.10",
    "jwa": "2.0.1",
    "jws": "4.0.1",
    "lucide-react": "^1.14.0",
    "lz4-napi": "^2.9.0",
    "react-i18next": "^17.0.7",
    "react-resizable-panels": "^4.11.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "optionalDependencies": {
    "@antoniomuso/lz4-napi-darwin-arm64": "2.9.0",
    "@antoniomuso/lz4-napi-darwin-x64": "2.9.0",
    "@antoniomuso/lz4-napi-win32-x64-msvc": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
